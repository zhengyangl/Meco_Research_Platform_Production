# .env.example — copy to .env (or export these directly in your shell /
# systemd service / cron environment) and fill in real values.
# NEVER commit a file containing real credentials. .env is gitignored.

# ── Database (used by: ingest_initial.py, ingest_incremental.py,
#    text_analysis.py, aggregate.py, run_pipeline.py, explorer.py) ──
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/me_dashboard

# ── OpenRouter (used by: classify.py) ──
# Each maintainer registers their own OpenRouter account and generates
# their own key — never share or hardcode this. See docs/handover.md.
OPENROUTER_API_KEY=sk-or-v1-your-own-key-here

# ── Google service account (used by: classify.py's review-sheet
#    integration, explorer.py's misclassification-report sheet,
#    run_pipeline.py's Drive folder detection) ──
# Path to the downloaded JSON key file for the shared service account
# (meco-explorer-feedback@<project>.iam.gserviceaccount.com or whichever
# account is currently in use). Every Sheet/Drive folder the pipeline
# touches must be individually shared with this account as Editor — being
# the same account elsewhere does NOT grant access automatically.
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service_account.json

# Optional — overrides the default review-queue sheet ID hardcoded in
# classify.py (DEFAULT_REVIEW_SHEET_ID). Only set this if migrating to a
# different sheet.
# REVIEW_SHEET_ID=

# ── explorer.py — Streamlit secrets, NOT env vars ──
# The crowd-sourced misclassification-report sheet in explorer.py reads
# its credentials from .streamlit/secrets.toml (Streamlit's own secrets
# mechanism, since explorer.py runs inside Streamlit and can use st.secrets
# directly), not from these environment variables. See
# .streamlit/secrets.toml.example (not committed — ask a maintainer with
# access, or recreate it from the service account JSON + sheet ID above).
